# Copy this file to .env and fill in the values. Never commit the real .env.

# App
APP_NAME=Meeting Intelligence Engine
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./meeting_intelligence.db

# Language model used for action items, timeline, decisions and emails.
# LLM_PROVIDER can be groq, anthropic or ollama.
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Transcription: "local" runs Whisper on this machine, "groq" uses Groq's hosted Whisper.
# Groq needs GROQ_API_KEY above and accepts audio files up to 25 MB on the free tier.
TRANSCRIPTION_PROVIDER=local
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_MODEL_SIZE=base

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# Frontend addresses allowed to call the API, separated by commas
CORS_ORIGINS=http://localhost:3000

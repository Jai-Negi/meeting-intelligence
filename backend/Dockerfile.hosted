# Slim image for hosting. It installs only the base requirements, so there is
# no local Whisper, no torch and no ffmpeg, and transcription goes through
# Groq's hosted Whisper instead. Most hosts set $PORT; 8000 is the fallback.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRANSCRIPTION_PROVIDER=groq

WORKDIR /app

COPY requirements-base.txt .
RUN pip install --no-cache-dir -r requirements-base.txt

COPY app ./app

RUN mkdir -p uploads data && useradd --create-home appuser && chown -R appuser /app
USER appuser

EXPOSE 8000

CMD ["sh", "-c", "exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
